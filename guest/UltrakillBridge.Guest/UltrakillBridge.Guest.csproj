<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>UltrakillBridge.Guest</AssemblyName>
    <RootNamespace>UltrakillBridge.Guest</RootNamespace>
    <!-- Override on the command line if ULTRAKILL lives elsewhere: dotnet build -p:UltrakillDir="D:\Games\ULTRAKILL" -->
    <UltrakillDir Condition="'$(UltrakillDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ULTRAKILL</UltrakillDir>
    <UltrakillManaged>$(UltrakillDir)\ULTRAKILL_Data\Managed</UltrakillManaged>
    <!-- BepInEx 5 core; scripts\Build.ps1 downloads it into .tools\ -->
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)..\..\.tools\bepinex5-x64\BepInEx\core</BepInExCore>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(UltrakillManaged)\Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="$(UltrakillManaged)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(UltrakillManaged)\Unity.InputSystem.dll" Private="false" Condition="Exists('$(UltrakillManaged)\Unity.InputSystem.dll')" />
    <Reference Include="$(UltrakillManaged)\Unity.Addressables.dll" Private="false" Condition="Exists('$(UltrakillManaged)\Unity.Addressables.dll')" />
    <Reference Include="$(UltrakillManaged)\Unity.ResourceManager.dll" Private="false" Condition="Exists('$(UltrakillManaged)\Unity.ResourceManager.dll')" />
    <Reference Include="$(UltrakillManaged)\Unity.TextMeshPro.dll" Private="false" Condition="Exists('$(UltrakillManaged)\Unity.TextMeshPro.dll')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\protocol\csharp\UltrakillBridge.Protocol\UltrakillBridge.Protocol.csproj" />
  </ItemGroup>
</Project>
